import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

async function main() {
  console.log('Start seeding ...');

  // 1. Create Charities
  const heartFoundation = await prisma.charity.upsert({
    where: { name: 'Heart Foundation' },
    update: {},
    create: {
      name: 'Heart Foundation',
      description: 'Fighting heart disease in Australia.',
      mission: 'To improve heart health for all Australians.',
      logoUrl: 'https://placehold.co/100x100?text=HF',
      websiteUrl: 'https://heartfoundation.org.au',
      stripeId: 'acct_123',
      active: true,
    },
  });

  const beyondBlue = await prisma.charity.upsert({
    where: { name: 'Beyond Blue' },
    update: {},
    create: {
      name: 'Beyond Blue',
      description: 'Providing support for anxiety and depression.',
      mission: 'To help everyone in Australia achieve their best possible mental health.',
      logoUrl: 'https://placehold.co/100x100?text=BB',
      websiteUrl: 'https://beyondblue.org.au',
      stripeId: 'acct_456',
      active: true,
    },
  });

  const redCross = await prisma.charity.upsert({
    where: { name: 'Red Cross' },
    update: {},
    create: {
      name: 'Red Cross',
      description: 'Humanitarian aid and community services.',
      mission: 'To alleviate human suffering wherever it may be found.',
      logoUrl: 'https://placehold.co/100x100?text=RC',
      websiteUrl: 'https://redcross.org.au',
      stripeId: 'acct_789',
      active: true,
    },
  });

  console.log('Created charities:', { heartFoundation, beyondBlue, redCross });

  // 2. Create Admin User
  const admin = await prisma.user.upsert({
    where: { email: 'admin@digitalheroes.com' },
    update: {},
    create: {
      email: 'admin@digitalheroes.com',
      name: 'Admin User',
      passwordHash: 'admin123', // In real app, hash this!
      role: 'ADMIN',
      image: 'https://github.com/shadcn.png',
    },
  });

  console.log('Created admin user:', admin);

  // 3. Create a Demo Player
  const player = await prisma.user.upsert({
    where: { email: 'player@demo.com' },
    update: {},
    create: {
      email: 'player@demo.com',
      name: 'Demo Player',
      passwordHash: 'password123',
      role: 'USER',
      image: 'https://github.com/shadcn.png',
      subscription: {
        create: {
          stripeId: 'sub_demo_123',
          status: 'ACTIVE',
          planId: 'monthly-basic',
          currentPeriodEnd: new Date(new Date().setMonth(new Date().getMonth() + 1)),
        }
      },
      charitySelect: {
        create: {
          charityId: heartFoundation.id,
        }
      },
      scores: { // Add some scores for dashboard
        create: [
          { score: 72, course: 'Royal Melbourne', date: new Date() },
          { score: 75, course: 'Kingston Heath', date: new Date(Date.now() - 86400000) },
        ]
      }
    },
  });

  console.log('Created demo player:', player);

  console.log('Seeding finished.');
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
